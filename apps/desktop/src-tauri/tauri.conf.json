{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermess Agent Desktop",
  "version": "0.1.0",
  "identifier": "com.hermess.agentdesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Hermess Agent Desktop", "width": 1080, "height": 760 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
