{
  "name": "@hermess/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/public.tsx"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
