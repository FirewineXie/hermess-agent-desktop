{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermess.local/contracts/backend-info.schema.json",
  "title": "BackendInfo",
  "type": "object",
  "additionalProperties": false,
  "required": ["port", "pid", "replay_epoch"],
  "properties": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "pid": { "type": "integer", "minimum": 1 },
    "replay_epoch": { "type": "string", "minLength": 1 }
  }
}
