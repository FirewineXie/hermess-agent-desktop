{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermess.local/contracts/backend-info.schema.json",
  "title": "BackendInfo",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "pid", "replay_epoch", "connection_id"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": "integer", "minimum": 1 },
        "replay_epoch": { "type": "string", "minLength": 1 },
        "connection_id": { "enum": ["local"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connection_id", "replay_epoch", "label"],
      "properties": {
        "kind": { "enum": ["remote"] },
        "connection_id": { "type": "string", "format": "uuid" },
        "replay_epoch": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
